# VEXA training arena (blockout). Units: meters. Generated by hand for movement/netcode testing.
name training
# floor and outer walls
box -25 -1 -25 25 0 25 concrete
box -25 0 -25.5 25 6 -25 concrete
box -25 0 25 25 6 25.5 concrete
box -25.5 0 -25 -25 6 25 concrete
box 25 0 -25 25.5 6 25 concrete
# central thick wall with a doorway (no wallbang)
box -12 0 -0.4 -1.2 4 0.4 brick
box 1.2 0 -0.4 12 4 0.4 brick
box -1.2 2.4 -0.4 1.2 4 0.4 brick
# thin wooden wall (wallbang test)
box 14 0 -6 14.1 3 6 wood
# crates: 1.1 m (jumpable), 1.6 m (crouch-jump), 2.2 m stack
box -6 0 8 -4.8 1.1 9.2 wood
box -4.8 0 8 -3.6 1.6 9.2 wood
box -4.8 1.6 8 -3.6 2.2 9.2 wood
box 5 0 -10 6.2 1.1 -8.8 wood
box 6.2 0 -10 7.4 1.1 -8.8 wood
# stairs up to a platform (0.4 m steps)
box 15 0 10 16 0.4 14 concrete
box 16 0 10 17 0.8 14 concrete
box 17 0 10 18 1.2 14 concrete
box 18 0 10 19 1.6 14 concrete
box 19 0 10 24 2.0 20 concrete
# metal container
box -18 0 -16 -12 2.6 -13.6 metal
# low cover
box -3 0 -12 3 0.9 -11.6 concrete
# spawns
spawn T -20 0 20 135
spawn T -16 0 22 160
spawn T -10 0 21 180
spawn CT 20 0 -20 -45
spawn CT 16 0 -22 -20
spawn CT 10 0 -21 0
spawn DM 0 0 15 180
spawn DM 0 0 -15 0
spawn DM -20 0 0 90
spawn DM 20 0 0 -90
site A 8 8 24 24
buyzone T -25 15 -5 25
buyzone CT 5 -25 25 -15
