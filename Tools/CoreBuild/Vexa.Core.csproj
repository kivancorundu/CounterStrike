<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the Unity-independent simulation core exactly like Unity would (netstandard2.1, C# 9). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Vexa.Core</AssemblyName>
    <RootNamespace>Vexa.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Game/Assets/Vexa/Core/**/*.cs" />
  </ItemGroup>
</Project>
